diff --git a/frontend/src/pages/Customer360.vue b/frontend/src/pages/Customer360.vue
new file mode 100644
index 0000000..e526d42
--- /dev/null
+++ b/frontend/src/pages/Customer360.vue
@@ -0,0 +1,182 @@
+<template>
+  <div class="flex h-full min-h-0 flex-col overflow-auto bg-surface-base">
+    <div class="border-b border-outline-gray-2 px-5 py-4">
+      <h1 class="text-xl font-semibold text-ink-gray-9">
+        Customer 360
+      </h1>
+    </div>
+
+    <div class="space-y-4 p-5">
+      <p class="text-sm text-ink-gray-6">
+        Unified customer profiles
+      </p>
+
+      <form
+        class="flex flex-wrap items-center gap-2"
+        @submit.prevent="searchCustomers"
+      >
+        <input
+          v-model="search"
+          class="w-full max-w-sm rounded-md border border-outline-gray-2 bg-surface-base px-3 py-2 text-sm"
+          placeholder="Search by name, phone or email"
+        />
+
+        <Button
+          variant="solid"
+          type="submit"
+          :disabled="loading"
+        >
+          Search
+        </Button>
+
+        <Button
+          :disabled="loading"
+          @click="resetSearch"
+        >
+          Reset
+        </Button>
+      </form>
+
+      <div v-if="loading" class="p-8 text-center">
+        Loading customers...
+      </div>
+
+      <div v-else-if="error" class="rounded-md border p-4 text-red-600">
+        {{ error }}
+        <Button class="ml-2" @click="loadCustomers">
+          Retry
+        </Button>
+      </div>
+
+      <div v-else class="overflow-x-auto rounded-lg border border-outline-gray-2">
+        <table class="w-full text-left text-sm">
+          <thead class="bg-surface-gray-2">
+            <tr>
+              <th class="p-3">Customer ID</th>
+              <th class="p-3">Customer Name</th>
+              <th class="p-3">Phone</th>
+              <th class="p-3">Updated At</th>
+            </tr>
+          </thead>
+
+          <tbody>
+            <tr
+              v-for="customer in customers"
+              :key="customer.customer_id"
+              class="border-t border-outline-gray-2 hover:bg-surface-gray-1"
+            >
+              <td class="p-3">
+                {{ customer.customer_id }}
+              </td>
+              <td class="p-3 font-medium">
+                {{ customer.display_name }}
+              </td>
+              <td class="p-3">
+                {{ customer.phone_masked || '-' }}
+              </td>
+              <td class="p-3">
+                {{ customer.updated_at || '-' }}
+              </td>
+            </tr>
+
+            <tr v-if="!customers.length">
+              <td colspan="4" class="p-8 text-center text-ink-gray-5">
+                No customers found
+              </td>
+            </tr>
+          </tbody>
+        </table>
+      </div>
+
+      <div class="flex items-center justify-between">
+        <span class="text-sm text-ink-gray-6">
+          {{ total }} customers
+        </span>
+
+        <div class="flex items-center gap-2">
+          <Button
+            :disabled="loading || page <= 1"
+            @click="changePage(page - 1)"
+          >
+            Previous
+          </Button>
+
+          <span class="text-sm">
+            {{ page }} / {{ totalPages }}
+          </span>
+
+          <Button
+            :disabled="loading || page >= totalPages"
+            @click="changePage(page + 1)"
+          >
+            Next
+          </Button>
+        </div>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, onMounted } from 'vue'
+import { Button, call } from 'frappe-ui'
+
+const customers = ref([])
+const search = ref('')
+const appliedSearch = ref('')
+const page = ref(1)
+const pageSize = 20
+const total = ref(0)
+const loading = ref(false)
+const error = ref('')
+
+const totalPages = computed(() =>
+  Math.max(1, Math.ceil(total.value / pageSize))
+)
+
+async function loadCustomers() {
+  loading.value = true
+  error.value = ''
+
+  try {
+    const data = await call(
+      'cellphones_c360.api.customer360.list_customers',
+      {
+        search: appliedSearch.value,
+        page: page.value,
+        page_size: pageSize,
+      }
+    )
+
+    customers.value = data.items || []
+    total.value = Number(data.total || 0)
+  } catch (err) {
+    customers.value = []
+    total.value = 0
+    error.value = 'Unable to load customers. Check your permissions or connection.'
+  } finally {
+    loading.value = false
+  }
+}
+
+function searchCustomers() {
+  if (loading.value) return
+  appliedSearch.value = search.value.trim()
+  page.value = 1
+  loadCustomers()
+}
+
+function resetSearch() {
+  search.value = ''
+  searchCustomers()
+}
+
+function changePage(newPage) {
+  if (loading.value) return
+  if (newPage < 1 || newPage > totalPages.value) return
+  page.value = newPage
+  loadCustomers()
+}
+
+onMounted(loadCustomers)
+</script>
