+        </form>
+
+        <p v-if="orders.loading" role="status">{{ __('Loading orders') }}</p>
+        <div v-else-if="orders.error" role="alert" class="flex flex-wrap items-center gap-2 text-sm text-ink-red-5">
+          {{ orders.error.messages?.[0] || __('Unable to load orders.') }}
+          <Button @click="orders.reload()">{{ __('Retry') }}</Button>
+        </div>
+        <p v-else-if="!orders.data?.items?.length" class="text-sm text-ink-gray-6">{{ __('No orders found') }}</p>
+        <div v-else class="overflow-x-auto rounded-lg border border-outline-gray-2">
+          <table class="w-full text-left text-sm">
+            <thead class="bg-surface-gray-2">
+              <tr>
+                <th v-for="column in columns" :key="column" scope="col" class="p-3">{{ __(column) }}</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr v-for="order in orders.data.items" :key="order.name" class="border-t border-outline-gray-2">
+                <th scope="row" class="whitespace-nowrap p-3 font-medium">
