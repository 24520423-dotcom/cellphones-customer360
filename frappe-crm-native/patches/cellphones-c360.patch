new file mode 100644
index 0000000..acb385e
--- /dev/null
+++ b/frontend/src/components/Customer360/LinkCRMRecord.vue
@@ -0,0 +1,65 @@
+<template>
+  <Dialog v-model:open="open" :title="__('Link CRM Record')">
+    <form class="space-y-4" @submit.prevent="save">
+      <FormControl v-model="doctype" type="select" :options="options" :label="__('Record type')" :disabled="saving" />
+      <Link
+        v-if="doctype"
+        v-model="record"
+        :key="doctype"
+        :label="__(doctype)"
+        :doctype="doctype"
+        :disabled="saving"
+        required
+      />
+      <p v-if="error" role="alert" class="text-sm text-ink-red-5">{{ error }}</p>
+      <div class="flex justify-end">
+        <Button type="submit" variant="solid" :disabled="!record" :loading="saving">{{ __('Link Record') }}</Button>
+      </div>
+    </form>
+  </Dialog>
+</template>
+
+<script setup>
+import Link from '@/components/Controls/Link.vue'
+import { Button, Dialog, FormControl, call, toast } from 'frappe-ui'
+import { computed, ref, watch } from 'vue'
+
+const props = defineProps({
+  customer: { type: String, required: true },
+  doctypes: { type: Array, required: true },
+})
+const emit = defineEmits(['saved'])
+const open = defineModel({ type: Boolean })
+const doctype = ref('')
+const record = ref('')
+const error = ref('')
+const saving = ref(false)
+const options = computed(() => props.doctypes.map((type) => ({ value: type, label: __(type) })))
+
+watch(open, (shown) => {
+  if (shown) {
+    doctype.value = props.doctypes[0] || ''
+    record.value = ''
+    error.value = ''
+  }
+})
+watch(doctype, () => { record.value = '' })
+
+async function save() {
+  if (saving.value || !record.value) return
+  saving.value = true
+  error.value = ''
+  try {
+    await call('cellphones_c360.api.crm_links.link_record', {
+      customer: props.customer, doctype: doctype.value, record: record.value,
+    })
+    open.value = false
+    toast.success(__('CRM record linked'))
+    emit('saved')
+  } catch (err) {
+    error.value = err.messages?.[0] || __('Unable to link the CRM record.')
+  } finally {
+    saving.value = false
+  }
+}
+</script>
