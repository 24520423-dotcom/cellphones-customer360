@@ -0,0 +1,126 @@
+<template>
+  <main class="flex h-full min-h-0 flex-col overflow-auto bg-surface-base">
+    <header class="border-b border-outline-gray-2 px-5 py-4">
+      <h1 class="text-xl font-semibold text-ink-gray-9">{{ __('Customer Analytics') }}</h1>
+    </header>
+    <div class="space-y-6 p-5">
+      <form class="flex flex-wrap items-end gap-3" @submit.prevent="applyPeriod">
+        <FormControl v-model="period" :label="__('Period')" type="select" :options="periods" />
+        <template v-if="period === 'custom'">
+          <FormControl v-model="start" :label="__('From date')" type="date" />
+          <FormControl v-model="end" :label="__('To date')" type="date" />
+        </template>
+        <Button type="submit" variant="solid" :loading="kpis.loading" :disabled="period === 'custom' && (!start || !end)">
+          {{ __('Apply') }}
+        </Button>
+      </form>
+
+      <p v-if="kpis.loading" role="status">{{ __('Loading analytics') }}</p>
+      <p v-else-if="kpis.error" role="alert" class="text-sm text-ink-red-5">
+        {{ kpis.error.messages?.[0] || __('Unable to load analytics.') }}
+        <Button @click="kpis.reload()">{{ __('Retry') }}</Button>
+      </p>
+      <p v-else-if="!groups.length" class="text-sm text-ink-gray-6">{{ __('No analytics are available for this account.') }}</p>
+      <template v-else>
+        <section v-for="group in groups" :key="group.title" class="space-y-3">
+          <h2 class="text-lg font-semibold">{{ __(group.title) }}</h2>
+          <dl class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
+            <div v-for="[label, value, format] in group.cards" :key="label" class="rounded-lg border border-outline-gray-2 p-4">
+              <dt class="text-sm text-ink-gray-6">{{ __(label) }}</dt>
+              <dd class="mt-2 text-lg font-semibold tabular-nums">{{ formatValue(value, format) }}</dd>
+            </div>
+          </dl>
+          <div v-if="group.charts.length" class="grid gap-4 xl:grid-cols-2">
+            <ChartCard v-for="[title, data] in group.charts" :key="title" class="min-h-64">
+              <BarChart
+                v-if="data?.length"
+                :title="__(title)"
+                :data="data.map(row => ({ label: __(row.label), count: row.count }))"
+                x="label"
+                :y="['count']"
+                :series-config="{ count: { color: '#D70018', showDataLabels: true } }"
+              />
+              <p v-else class="p-4 text-sm text-ink-gray-6">{{ __(title) }} · {{ __('No data for this period') }}</p>
+            </ChartCard>
+          </div>
+        </section>
+      </template>
+    </div>
+  </main>
+</template>
+
+<script setup>
+import { Button, FormControl, createResource } from 'frappe-ui'
+import { BarChart, ChartCard } from 'frappe-ui/charts'
+import { computed, ref } from 'vue'
+import { formatVND } from '@/components/Customer360/format'
+
+const period = ref('30d')
+const start = ref('')
+const end = ref('')
+const periods = [
+  { value: '7d', label: __('Last 7 days') },
+  { value: '30d', label: __('Last 30 days') },
+  { value: '90d', label: __('Last 90 days') },
+  { value: 'all', label: __('All dates') },
+  { value: 'custom', label: __('Custom period') },
+]
+const kpis = createResource({
+  url: 'cellphones_c360.api.analytics.get_analytics_overview',
+  method: 'GET',
+  params: { period: period.value },
+  auto: true,
+})
+const percent = new Intl.NumberFormat('vi-VN', { style: 'percent', maximumFractionDigits: 1 })
+const number = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 1 })
+
+function applyPeriod() {
+  kpis.fetch(period.value === 'custom'
+    ? { from_date: start.value, to_date: end.value }
+    : { period: period.value })
+}
+
+function formatValue(value, format) {
+  if (value == null) return '—'
+  if (format === 'money') return formatVND(value)
+  return (format === 'percent' ? percent : number).format(value)
+}
+
+const groups = computed(() => {
+  const { customers, leads, deals, orders, tickets } = kpis.data || {}
+  return [
