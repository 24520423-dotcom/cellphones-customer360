+      Loading customer profile...
+    </div>
+
+    <div v-else-if="error" class="p-5 text-red-600">
+      {{ error }}
+      <Button @click="loadProfile">Retry</Button>
+    </div>
+
+    <div v-else-if="data" class="space-y-5 p-5">
+
+      <!-- Customer header -->
+      <div class="rounded-lg border border-outline-gray-2 p-5">
+        <h2 class="text-2xl font-semibold text-ink-gray-9">
+          {{ data.customer.customer_name }}
