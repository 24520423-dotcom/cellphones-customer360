+  comparison.value = null
+  reason.value = ''
+  verified.value = false
+  error.value = ''
+  loadingPreview.value = !!name
+  if (!name) return
+  let current = true
+  onCleanup(() => { current = false })
+  try {
+    const result = await frappeRequest({
