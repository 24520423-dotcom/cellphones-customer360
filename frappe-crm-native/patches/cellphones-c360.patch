+      method: 'GET',
+      params: { source: name, target: props.customer.name },
+    })
+    if (!current) return
+    comparison.value = result
+    selected.value = Object.fromEntries(result.fields.map((field) => [field.fieldname, field.suggested]))
+  } catch (err) {
+    if (current) error.value = err.messages?.[0] || __('Unable to compare these profiles.')
+  } finally {
+    if (current) loadingPreview.value = false
+  }
+})
+
+async function confirmMerge() {
+  if (saving.value || !comparison.value?.can_merge || !verified.value || !reason.value.trim()) return
+  const { source, target, source_modified, target_modified } = comparison.value
+  saving.value = true
+  error.value = ''
+  try {
+    await call('cellphones_c360.api.merge.merge_customers', {
+      source, target, source_modified, target_modified,
+      selected: selected.value, reason: reason.value.trim(), verified: verified.value,
+    })
+    open.value = false
+    toast.success(__('Profiles merged'))
+    emit('saved')
+  } catch (err) {
+    error.value = err.messages?.[0] || __('Unable to merge these profiles.')
+  } finally {
+    saving.value = false
+  }
+}
+</script>
