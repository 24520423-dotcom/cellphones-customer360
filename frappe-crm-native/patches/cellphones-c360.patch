+      charts: [['Online and offline', customers.byChannel], ['Customer segments', customers.segments]],
+    },
+    (leads || deals) && {
+      title: 'Sales pipeline',
+      cards: [
+        ['Leads', leads?.total], ['Deals', deals?.total], ['Lead conversion rate', deals?.conversionRate, 'percent'],
+        ['Deal win rate', deals?.winRate, 'percent'], ['Open pipeline value', deals?.pipelineValue, 'money'],
+      ],
+      charts: [['Lead status', leads?.byStatus], ['Deal stages', deals?.byStage]],
+    },
+    orders && {
+      title: 'Orders',
+      cards: [
+        ['Orders', orders.total], ['Completed', orders.completed], ['Cancelled', orders.cancelled],
+        ['Valid order value', orders.validValue, 'money'], ['Confirmed receipts', orders.confirmedReceipts, 'money'],
+      ],
+      charts: [['Orders by status', orders.byStatus]],
+    },
+    tickets && {
+      title: 'After-sales',
+      cards: [
+        ['Tickets', tickets.total], ['Backlog', tickets.backlog], ['Resolved', tickets.resolved],
+        ['Resolution rate', tickets.resolutionRate, 'percent'], ['Average handling time (hours)', tickets.averageResolutionHours],
+      ],
+      charts: [['Tickets by status', tickets.byStatus]],
+    },
+  ].filter(Boolean)
+})
+</script>
