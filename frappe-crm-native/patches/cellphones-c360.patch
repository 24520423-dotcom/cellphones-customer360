+<template>
+  <main class="flex h-full min-h-0 flex-col overflow-auto bg-surface-base">
+    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-outline-gray-2 px-5 py-4">
+      <h1 class="text-xl font-semibold text-ink-gray-9">{{ __(config.title) }}</h1>
+      <a
+        v-if="access.data?.canCreate"
+        class="rounded-md bg-surface-gray-7 px-3 py-2 text-sm font-medium text-white hover:underline"
+        :href="deskRecord('new-' + config.desk + '-1')"
+      >
+        {{ __(config.createLabel) }}
+      </a>
+    </header>
+
+    <section class="space-y-4 p-5">
+      <p v-if="access.loading" role="status">{{ __('Checking access') }}</p>
+      <p v-else-if="access.error" role="alert">{{ __('Unable to check access.') }}</p>
+      <p v-else-if="!access.data?.canRead" role="alert">{{ __('You do not have access to this worklist.') }}</p>
+
+      <template v-else>
+        <form class="flex flex-wrap items-end gap-3" @submit.prevent="search">
+          <FormControl
+            v-for="[key, label, type, field] in config.controls"
+            :key="key"
+            v-model="filters[key]"
+            :label="__(label)"
+            :type="type"
+            :options="field ? options(field) : undefined"
+          />
+          <Button type="submit" variant="solid" :loading="items.loading">{{ __('Search') }}</Button>
+        </form>
+
+        <p v-if="items.loading" role="status">{{ __('Loading records') }}</p>
+        <div v-else-if="items.error" role="alert" class="flex flex-wrap items-center gap-2 text-sm text-ink-red-5">
+          {{ items.error.messages?.[0] || __('Unable to load items.') }}
+          <Button @click="items.reload()">{{ __('Retry') }}</Button>
+        </div>
+        <p v-else-if="!items.data?.items?.length" class="text-sm text-ink-gray-6">{{ __(config.empty) }}</p>
+        <div v-else class="overflow-x-auto rounded-lg border border-outline-gray-2">
+          <table class="w-full text-left text-sm">
+            <thead class="bg-surface-gray-2">
+              <tr>
+                <th v-for="[key, label] in config.columns" :key="key" scope="col" class="p-3">{{ __(label) }}</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr v-for="row in items.data.items" :key="row.name" class="border-t border-outline-gray-2">
+                <template v-for="[key, , format] in config.columns" :key="key">
+                  <th v-if="key === 'name'" scope="row" class="whitespace-nowrap p-3 font-medium">
+                    <a class="text-[#D70018] hover:underline" :href="deskRecord(row.name)">{{ row.name }}</a>
+                  </th>
+                  <td v-else class="p-3">
+                    <RouterLink
+                      v-if="key === 'customer' && row.customer"
+                      class="whitespace-nowrap hover:underline"
+                      :to="{ name: 'Customer360Detail', params: { customerId: row.customer } }"
+                    >{{ row.customer }}</RouterLink>
+                    <Badge v-else-if="format === 'badge'" :label="row[key] ? __(row[key]) : '—'" />
+                    <span v-else-if="format === 'date'" class="whitespace-nowrap">{{ formatDate(row[key]) }}</span>
+                    <span v-else-if="format === 'money'" class="whitespace-nowrap tabular-nums">{{ formatVND(row[key]) }}</span>
+                    <span v-else-if="format === 'translate'">{{ row[key] ? __(row[key]) : '—' }}</span>
+                    <span v-else>{{ row[key] || '—' }}</span>
+                  </td>
+                </template>
+              </tr>
+            </tbody>
+          </table>
+        </div>
+        <nav v-if="items.data" :aria-label="__('Worklist pages')" class="flex items-center justify-end gap-3">
+          <Button :disabled="page <= 1 || items.loading" @click="turnPage(-1)">{{ __('Previous') }}</Button>
+          <span class="text-sm">{{ page }}</span>
+          <Button :disabled="!items.data.has_more || items.loading" @click="turnPage(1)">{{ __('Next') }}</Button>
+        </nav>
+      </template>
+    </section>
+  </main>
+</template>
+
+<script setup>
+import { Badge, Button, FormControl, createResource } from 'frappe-ui'
+import { reactive, ref } from 'vue'
+import { RouterLink, useRoute } from 'vue-router'
+import { formatDate, formatVND } from '@/components/Customer360/format'
+
+const props = defineProps({ kind: { type: String, required: true } })
+const route = useRoute()
+const configs = {
+  orders: {
+    title: 'Orders', createLabel: 'New Order', empty: 'No orders found', desk: 'customer-order',
+    list: 'orders.list_orders', access: 'orders.get_access',
+    controls: [
+      ['search', 'Order ID or customer', 'text'],
+      ['status', 'Order status', 'select', 'order_status'],
+      ['channel', 'Sales channel', 'select', 'sales_channel'],
+      ['from_date', 'From date', 'date'],
+      ['to_date', 'To date', 'date'],
+    ],
+    columns: [
+      ['name', 'Order ID'], ['customer', 'Customer'], ['order_date', 'Order date', 'date'],
+      ['sales_channel', 'Sales channel', 'translate'], ['order_status', 'Order status', 'badge'],
+      ['payment_status', 'Payment', 'translate'], ['fulfillment_status', 'Fulfillment', 'translate'],
+      ['total_amount', 'Order value', 'money'],
+    ],
+  },
+  tickets: {
+    title: 'After-sales', createLabel: 'New Ticket', empty: 'No tickets found', desk: 'customer-support-ticket',
+    list: 'after_sales.list_tickets', access: 'after_sales.get_capabilities',
+    controls: [
+      ['search', 'Ticket ID or subject', 'text'],
+      ['status', 'Status', 'select', 'ticket_status'],
+      ['ticket_type', 'Type', 'select', 'ticket_type'],
+      ['priority', 'Priority', 'select', 'priority'],
+    ],
+    columns: [
+      ['name', 'Ticket ID'], ['subject', 'Subject'], ['customer', 'Customer'],
+      ['ticket_type', 'Type', 'translate'], ['priority', 'Priority', 'translate'],
+      ['ticket_status', 'Status', 'badge'], ['assigned_to', 'Assigned to'], ['created_date', 'Created', 'date'],
+    ],
+  },
+}
+const config = configs[props.kind]
+const filters = reactive(Object.fromEntries(config.controls.map(([key]) => [key, ''])))
+const customer = String(route.query.customer || '')
+if (props.kind === 'orders') filters.search = customer
+if (props.kind === 'tickets' && customer) filters.customer = customer
+const page = ref(1)
+let applied = { ...filters }
+
+const items = createResource({
+  url: 'cellphones_c360.api.' + config.list,
+  method: 'GET',
+  makeParams: () => ({ ...applied, page: page.value }),
+})
+
+const access = createResource({
+  url: 'cellphones_c360.api.' + config.access,
+  method: 'GET',
+  auto: true,
+  onSuccess(data) {
+    if (data.canRead) search()
+  },
+})
+
+function options(field) {
+  return [
+    { label: __('All'), value: '' },
+    ...(access.data?.filters[field] || []).map((value) => ({ label: __(value), value })),
+  ]
+}
+
+function deskRecord(name) {
+  return '/app/' + config.desk + '/' + encodeURIComponent(name)
+}
+
+function search() {
+  applied = { ...filters }
+  page.value = 1
+  items.fetch()
+}
+
+function turnPage(step) {
+  page.value += step
+  items.fetch()
+}
+</script>
