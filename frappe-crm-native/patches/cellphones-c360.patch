+import { RouterLink } from 'vue-router'
+
+const props = defineProps({ csvHeader: { type: String, required: true } })
+const emit = defineEmits(['imported'])
+const open = defineModel({ type: Boolean })
+const templateUrl = computed(() => 'data:text/csv;charset=utf-8,' + encodeURIComponent(props.csvHeader + '\r\n'))
+const file = ref(null)
+const submitting = ref(false)
+const rows = ref([])
+const error = ref('')
+
+function selectFile(event) {
+  file.value = event.target.files[0] || null
+  rows.value = []
+  error.value = ''
+}
+
+function sourceUrl(name) {
+  return '/app/c360-source-record/' + encodeURIComponent(name)
+}
+
+async function submit() {
+  if (!file.value || submitting.value) return
+  submitting.value = true
+  error.value = ''
+  try {
+    const result = await call('cellphones_c360.api.intake.process_csv', { csv_text: await file.value.text() })
+    rows.value = result.items
+    emit('imported')
+  } catch (err) {
+    error.value = customerError(err, 'Unable to import customers.', __)
+  } finally {
+    submitting.value = false
+  }
+}
+</script>
