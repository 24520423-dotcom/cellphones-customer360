diff --git a/frontend/src/components/Customer360/errors.js b/frontend/src/components/Customer360/errors.js
new file mode 100644
index 0000000..d4d07ab
--- /dev/null
+++ b/frontend/src/components/Customer360/errors.js
@@ -0,0 +1,27 @@
+export function customerError(error, fallback, translate = (message) => message) {
+  const type = error?.exc_type
+  const status = error?.response?.status ?? error?.status
+
+  if (type === 'CSRFTokenError' || type === 'AuthenticationError' || status === 401) {
+    return translate('Your session has expired. Sign in and try again.')
+  }
+  if (type === 'PermissionError' || status === 403) {
+    return translate('You do not have permission for this action.')
+  }
+  if (type === 'DoesNotExistError' || status === 404) {
+    return translate('The requested record is unavailable.')
+  }
+  if (type === 'InvalidTransition') {
+    return translate('The requested status transition is not allowed.')
+  }
+  if (type === 'TimestampMismatchError' || status === 409) {
+    return translate('The record has changed. Reload and try again.')
+  }
+  if ([
+    'ValidationError', 'MandatoryError', 'LinkValidationError', 'DataError',
+    'DuplicateEntryError', 'InvalidEmailAddressError',
+  ].includes(type) || [400, 417, 422].includes(status)) {
+    return translate('Check the entered values and try again.')
+  }
+  return translate(fallback)
+}
