+                <td class="break-words p-2">{{ field.target || '—' }}</td>
+                <td class="break-words p-2">{{ field.source || '—' }}</td>
+                <td v-if="comparison.can_merge" class="p-2">
+                  <FormControl
+                    v-model="selected[field.fieldname]"
