+        </p>
+        <p class="mt-2 text-sm text-ink-gray-6">
+          {{ data.customer.name }}
+        </p>
+      </div>
+
+      <!-- Summary cards -->
+      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
+        <div
+          v-for="item in summary"
+          :key="item.label"
+          class="rounded-lg border border-outline-gray-2 p-4"
+        >
+          <p class="text-sm text-ink-gray-6">{{ item.label }}</p>
+          <p class="mt-2 text-xl font-semibold">{{ item.value }}</p>
+        </div>
+      </div>
+
+      <!-- Tabs -->
+      <div class="flex flex-wrap gap-4 border-b border-outline-gray-2">
+        <button
+          v-for="tab in tabs"
+          :key="tab"
+          type="button"
+          class="border-b-2 px-2 py-3 text-sm"
+          :class="activeTab === tab
+            ? 'border-[#D70018] font-semibold text-[#D70018]'
+            : 'border-transparent text-ink-gray-6'"
+          @click="selectTab(tab)"
+        >
+          {{ tab }}
+        </button>
+      </div>
+
+      <!-- Overview -->
+      <div
+        v-if="activeTab === 'Overview'"
+        class="grid grid-cols-1 gap-4 md:grid-cols-2"
+      >
+        <div
+          v-for="item in customerFields"
+          :key="item.label"
+          class="rounded-lg border border-outline-gray-2 p-4"
+        >
+          <p class="text-sm text-ink-gray-6">{{ item.label }}</p>
+          <p class="mt-2 font-medium break-words">
+            {{ item.value || '-' }}
+          </p>
+        </div>
+      </div>
+
+      <!-- Orders -->
+      <div v-if="activeTab === 'Orders'" class="space-y-3">
+        <p v-if="!data.orders?.length">No orders found.</p>
+
+        <div
+          v-for="order in data.orders"
+          :key="order.name"
+          class="rounded-lg border border-outline-gray-2 p-4"
+        >
+          <h3 class="font-semibold">{{ order.name }}</h3>
+          <p class="mt-2 text-sm">{{ order.order_date || '-' }}</p>
+          <p class="mt-1 text-sm">Channel: {{ order.sales_channel || '-' }}</p>
+          <p class="mt-1 text-sm">Status: {{ order.order_status }}</p>
+          <p class="mt-2 font-semibold">
+            {{ money(order.total_amount) }}
+          </p>
+
+          <div class="mt-3 overflow-x-auto">
+            <table class="w-full text-left text-sm">
+              <thead class="bg-surface-gray-2">
+                <tr>
+                  <th class="p-2">Product</th>
+                  <th class="p-2">Quantity</th>
+                  <th class="p-2">Unit Price</th>
+                  <th class="p-2">Amount</th>
+                </tr>
+              </thead>
+              <tbody>
+                <tr
+                  v-for="(item, index) in order.items"
+                  :key="index"
+                  class="border-t border-outline-gray-2"
+                >
+                  <td class="p-2">{{ item.product_name }}</td>
+                  <td class="p-2">{{ item.quantity }}</td>
+                  <td class="p-2">{{ money(item.unit_price) }}</td>
+                  <td class="p-2">{{ money(item.amount) }}</td>
+                </tr>
+              </tbody>
+            </table>
+          </div>
+        </div>
+      </div>
+
+      <!-- Leads and Deals -->
+      <div v-if="activeTab === 'Leads & Deals'" class="space-y-3">
+        <div v-if="data.lead" class="rounded-lg border p-4">
+          <h3 class="font-semibold">Linked Lead</h3>
+
+          <RouterLink
+            class="mt-2 block text-[#D70018]"
+            :to="{ name: 'Lead', params: { leadId: data.lead.name } }"
+          >
+            {{ data.lead.lead_name || data.lead.name }}
+          </RouterLink>
+
+          <p class="mt-1">Status: {{ data.lead.status }}</p>
+        </div>
+
+        <p v-else>No linked lead.</p>
+
+        <h3 class="font-semibold">Related Deals</h3>
+        <p v-if="!data.deals?.length">No deals found.</p>
+
+        <div
+          v-for="deal in data.deals"
+          :key="deal.name"
+          class="rounded-lg border border-outline-gray-2 p-4"
+        >
+          <RouterLink
+            class="font-medium text-[#D70018]"
+            :to="{ name: 'Deal', params: { dealId: deal.name } }"
+          >
+            {{ deal.name }}
+          </RouterLink>
+          <p class="mt-2">Status: {{ deal.status }}</p>
+          <p>Probability: {{ deal.probability ?? '-' }}%</p>
+        </div>
+      </div>
+
+      <!-- After-sales -->
+      <div v-if="activeTab === 'After-sales'" class="space-y-3">
+        <p v-if="!data.tickets?.length">No support tickets found.</p>
+
+        <div
+          v-for="ticket in data.tickets"
+          :key="ticket.name"
+          class="rounded-lg border border-outline-gray-2 p-4"
+        >
+          <h3 class="font-semibold">{{ ticket.subject }}</h3>
+          <p class="mt-2 text-sm">{{ ticket.name }}</p>
+          <p>Type: {{ ticket.ticket_type || '-' }}</p>
+          <p>Priority: {{ ticket.priority || '-' }}</p>
+          <p>Status: {{ ticket.ticket_status || '-' }}</p>
+          <p>Assigned to: {{ ticket.assigned_to || '-' }}</p>
+          <p>Related order: {{ ticket.related_order || '-' }}</p>
+          <p class="mt-2 whitespace-pre-wrap">
+            {{ ticket.description || '' }}
+          </p>
+        </div>
+      </div>
+
+      <!-- Timeline -->
+      <div v-if="activeTab === 'Timeline'" class="space-y-3">
+        <p v-if="timelineLoading">Loading timeline...</p>
+
+        <div v-else-if="timelineError">
+          <p class="text-red-600">{{ timelineError }}</p>
+          <Button @click="loadTimeline">Retry</Button>
+        </div>
+
+        <template v-else>
+          <p v-if="!timeline.length">No activities found.</p>
+
+          <div
+            v-for="event in timeline"
+            :key="event.id"
+            class="rounded-lg border border-outline-gray-2 p-4"
+          >
+            <p class="font-medium">{{ event.summary }}</p>
+            <p class="mt-2 text-sm text-ink-gray-6">
+              {{ event.occurred_at || '-' }}
+            </p>
+            <p class="text-sm">{{ event.type }}</p>
+          </div>
+
+          <div class="flex items-center justify-between">
+            <span>{{ timelineTotal }} activities</span>
+            <div class="flex items-center gap-2">
+              <Button
+                :disabled="timelinePage <= 1"
+                @click="changeTimelinePage(-1)"
+              >
+                Previous
+              </Button>
+              <span>{{ timelinePage }}</span>
+              <Button
+                :disabled="timelinePage * 20 >= timelineTotal"
+                @click="changeTimelinePage(1)"
+              >
+                Next
+              </Button>
+            </div>
+          </div>
+        </template>
+      </div>
+
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, watch } from 'vue'
+import { useRouter, RouterLink } from 'vue-router'
+import { Button, call } from 'frappe-ui'
+
+const props = defineProps({
+  customerId: { type: String, required: true },
+})
+
+const router = useRouter()
+const data = ref(null)
+const loading = ref(false)
+const error = ref('')
+
+const timeline = ref([])
+const timelineLoading = ref(false)
+const timelineError = ref('')
+const timelinePage = ref(1)
+const timelineTotal = ref(0)
+
+const tabs = [
+  'Overview',
+  'Orders',
+  'Leads & Deals',
+  'After-sales',
+  'Timeline',
+]
+
+const activeTab = ref('Overview')
+
+function money(value) {
+  if (value == null || value === '') return '-'
+  return new Intl.NumberFormat('vi-VN', {
+    style: 'currency',
+    currency: 'VND',
+  }).format(Number(value))
+}
+
+const summary = computed(() => {
+  const orders = data.value?.orders || []
+  const deals = data.value?.deals || []
+  const tickets = data.value?.tickets || []
+
+  return [
+    {
+      label: 'Order Value',
+      value: money(orders.reduce(
+        (sum, order) => sum + Number(order.total_amount || 0), 0
+      )),
+    },
+    { label: 'Orders', value: orders.length },
+    { label: 'Deals', value: deals.length },
+    { label: 'Support Tickets', value: tickets.length },
+  ]
+})
+
+const customerFields = computed(() => {
+  const c = data.value?.customer || {}
+
+  return [
+    { label: 'Customer ID', value: c.name },
+    { label: 'Full Name', value: c.customer_name },
+    { label: 'Phone', value: c.phone_number },
+    { label: 'Email', value: c.email },
+    { label: 'Customer Type', value: c.customer_type },
+    { label: 'Customer Status', value: c.customer_status },
+    { label: 'Source Channel', value: c.source_channel },
+    { label: 'Linked Contact', value: c.crm_contact },
+    { label: 'Linked Lead', value: c.crm_lead },
+  ]
+})
+
+let profileRequest = 0
+let timelineRequest = 0
+
+async function loadProfile() {
+  const request = ++profileRequest
+  loading.value = true
+  error.value = ''
+  data.value = null
+
+  try {
+    const result = await call(
+      'cellphones_c360.api.customer360.get_customer_360',
+      { customer_id: props.customerId }
+    )
+    if (request === profileRequest) data.value = result
+  } catch {
+    if (request === profileRequest) {
+      error.value = 'Unable to load customer profile.'
+    }
+  } finally {
+    if (request === profileRequest) loading.value = false
+  }
+}
+
+async function loadTimeline() {
+  const request = ++timelineRequest
+  timelineLoading.value = true
+  timelineError.value = ''
+
+  try {
+    const result = await call(
+      'cellphones_c360.api.customer360.get_customer_timeline',
+      {
+        customer_id: props.customerId,
+        page: timelinePage.value,
+        page_size: 20,
+      }
+    )
+
+    if (request === timelineRequest) {
+      timeline.value = result.items || []
+      timelineTotal.value = Number(result.total || 0)
+    }
+  } catch {
+    if (request === timelineRequest) {
+      timelineError.value = 'Unable to load customer timeline.'
+    }
+  } finally {
+    if (request === timelineRequest) timelineLoading.value = false
+  }
+}
+
+function selectTab(tab) {
+  activeTab.value = tab
+
+  if (tab === 'Timeline') {
+    loadTimeline()
+  }
+}
+
+function changeTimelinePage(step) {
+  timelinePage.value += step
