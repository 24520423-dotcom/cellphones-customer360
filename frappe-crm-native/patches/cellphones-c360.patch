+<script setup>
+import { Badge, Button, FormControl, createResource } from 'frappe-ui'
+import { reactive, ref } from 'vue'
+import { RouterLink, useRoute } from 'vue-router'
+import { formatDate, formatVND } from '@/components/Customer360/format'
+
+const route = useRoute()
+const filters = reactive({
+  search: String(route.query.customer || ''), status: '', channel: '', from_date: '', to_date: '',
+})
+const page = ref(1)
+let applied = { ...filters }
+const columns = ['Order ID', 'Customer', 'Order date', 'Sales channel', 'Order status', 'Payment', 'Fulfillment', 'Order value']
+
+const orders = createResource({
+  url: 'cellphones_c360.api.orders.list_orders',
+  method: 'GET',
+  makeParams: () => ({ ...applied, page: page.value }),
+})
+
+const access = createResource({
+  url: 'cellphones_c360.api.orders.get_access',
+  method: 'GET',
+  auto: true,
+  onSuccess(data) {
+    if (data.canRead) search()
+  },
+})
+
+function options(field) {
+  return [
+    { label: __('All'), value: '' },
+    ...(access.data?.filters[field] || []).map((value) => ({ label: __(value), value })),
+  ]
+}
+
+function deskOrder(name) {
+  return '/app/customer-order/' + encodeURIComponent(name)
+}
+
+function search() {
+  applied = { ...filters }
+  page.value = 1
+  orders.fetch()
+}
+
+function turnPage(step) {
+  page.value += step
+  orders.fetch()
+}
+</script>
