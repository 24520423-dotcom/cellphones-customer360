+<template>
+  <div class="flex h-full min-h-0 flex-col overflow-auto bg-surface-base">
+
+    <div class="flex items-center gap-3 border-b border-outline-gray-2 p-4">
+      <Button @click="router.push({ name: 'Customer360' })">
+        Back
+      </Button>
+      <h1 class="text-xl font-semibold">Customer Profile</h1>
+    </div>
+
