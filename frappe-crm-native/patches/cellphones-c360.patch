+          {{ __('Save') }}
+        </Button>
+      </div>
+    </form>
+  </Dialog>
+</template>
+
+<script setup>
+import Link from '@/components/Controls/Link.vue'
+import { Button, Dialog, FormControl, call, toast } from 'frappe-ui'
+import { ref, watch } from 'vue'
+
+const props = defineProps({ fields: { type: Array, required: true } })
+const emit = defineEmits(['saved'])
+const open = defineModel({ type: Boolean })
+const values = ref({})
+const error = ref('')
+const saving = ref(false)
+
+watch(open, (shown) => {
+  if (!shown) return
+  values.value = Object.fromEntries(
+    props.fields.map((field) => [field.fieldname, field.default ?? '']),
+  )
+  error.value = ''
+})
+
+function inputType(field) {
+  if (field.fieldtype === 'Select') return 'select'
+  if (field.options === 'Email') return 'email'
+  if (field.options === 'Phone') return 'tel'
+  return 'text'
+}
+
+function selectOptions(field) {
+  if (field.fieldtype !== 'Select') return undefined
+  const options = field.options.filter(Boolean).map((value) => ({ label: __(value), value }))
+  return field.required ? options : [{ label: __('Select an option'), value: '' }, ...options]
+}
+
+async function save() {
+  if (saving.value) return
+  error.value = ''
+  if (props.fields.some((field) => field.required && !values.value[field.fieldname]?.trim())) {
+    error.value = __('Fill in all required fields.')
+    return
+  }
+  saving.value = true
