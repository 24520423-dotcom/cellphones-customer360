+            </td>
+            <td class="space-y-1 p-2">
+              <p v-if="row.reason">{{ row.reason }}</p>
+              <RouterLink
+                v-if="row.customer"
+                class="underline"
+                :to="{ name: 'Customer360Detail', params: { customerId: row.customer } }"
+              >{{ row.customer }}</RouterLink>
+              <a
+                v-if="row.source_document"
+                :href="sourceUrl(row.source_document)"
+                class="block underline"
+              >{{ row.status === 'Needs Review' ? __('Review Source Record') : row.source_record_id }}</a>
